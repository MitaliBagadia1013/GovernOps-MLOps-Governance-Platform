ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mlops_registry
DB_USER=mlops_user
DB_PASSWORD=mlops_password

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

DB_ECHO=false

AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1

S3_MODEL_BUCKET=mlops-models
S3_DATA_BUCKET=mlops-data
S3_ARTIFACT_BUCKET=mlops-artifacts

RETRAINING_STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:retraining-workflow

SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/SageMakerExecutionRole
SAGEMAKER_INSTANCE_TYPE=ml.m5.xlarge

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=governops
MLFLOW_ARTIFACT_LOCATION=s3://mlops-artifacts

KUBEFLOW_HOST=http://localhost:8080
KUBEFLOW_NAMESPACE=kubeflow-mlops
SELDON_NAMESPACE=seldon-mlops

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

API_CORS_ORIGINS=["http://localhost:3000", "https://your-frontend.com"]

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/mlops/app.log

JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

ENCRYPTION_KEY=your-encryption-key-change-this

DRIFT_DETECTION_THRESHOLD=0.05
DRIFT_CONSECUTIVE_COUNT=3
DRIFT_CHECK_FREQUENCY=hourly

CANARY_TRAFFIC_PERCENT=5
CANARY_VALIDATION_PERIOD_MINUTES=30
CANARY_ERROR_RATE_THRESHOLD=0.1
CANARY_LATENCY_THRESHOLD_MS=500

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@company.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=governops@company.com
EMAIL_TO=data-science-team@company.com

PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_SERVICE_ID=your-service-id

MAX_BATCH_SIZE=1000
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

PGADMIN_DEFAULT_EMAIL=admin@mlops.com
PGADMIN_PASSWORD=admin
